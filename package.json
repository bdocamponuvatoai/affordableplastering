{
  "name": "affordable-plastering",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Affordable Plastering, a plastering and drywall contractor in Hudson, New Hampshire.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/fix-export-segments.mjs",
    "preview": "npx serve@14 out",
    "images": "node scripts/generate-images.mjs",
    "lint": "eslint",
    "test": "node --test \"src/lib/*.test.ts\"",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "^5"
  }
}
