# Copy to .env.local for local builds. On Vercel, set these in
# Project Settings → Environment Variables instead.

# Public origin of the site, with no trailing slash. Used for canonical URLs,
# Open Graph images, robots.txt and sitemap.xml.
# If unset: https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, otherwise
# http://localhost:3000.
# SITE_URL=https://www.example.com

# Let search engines index the site. Keep "false" until the owner approves
# launch. The build fails if this is "true" while the site URL is localhost.
SITE_INDEXABLE=false
